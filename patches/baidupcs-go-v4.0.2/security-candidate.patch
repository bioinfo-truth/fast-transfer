@@ -0,0 +1,50 @@
+// Security patch candidate: no live binding or permission is supplied here.
+package requester
+
+import (
+    "crypto/tls"
+    "errors"
+    "net/http"
+    "net/url"
+    "strings"
+)
+
+var ErrRequestPolicy = errors.New("request_policy_rejected")
+var ErrRequestFailed = errors.New("request_failed_redacted")
+
+func denyRedirect(req *http.Request, via []*http.Request) error {
+    return ErrRequestPolicy // No Location is followed, even on the same host.
+}
+
+type guardedTransport struct { next http.RoundTripper }
+
+func (g guardedTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+    if req == nil || req.URL == nil { return nil, ErrRequestPolicy }
+    u := req.URL
+    host := u.Hostname()
+    if u.Scheme != "https" || u.User != nil || u.Fragment != "" ||
+       (u.Port() != "" && u.Port() != "443") || req.Host != "" && req.Host != u.Host ||
+       !(host == "baidu.com" || strings.HasSuffix(host, ".baidu.com") ||
+         host == "baidupcs.com" || strings.HasSuffix(host, ".baidupcs.com")) {
+        return nil, ErrRequestPolicy
+    }
+    query, queryError := url.ParseQuery(u.RawQuery)
+    if queryError != nil { return nil, ErrRequestPolicy }
+    for key := range query {
+        switch strings.ToLower(key) {
+        case "bduss", "stoken", "ptoken", "cookie", "access_token", "refresh_token", "password", "authorization", "client_secret":
+            return nil, ErrRequestPolicy
+        }
+    }
+    // Protect the actual concrete network transport as well as its constructor.
+    if transport, ok := g.next.(*http.Transport); ok {
+        config := transport.TLSClientConfig
+        if config == nil || config.InsecureSkipVerify || config.MinVersion < tls.VersionTLS12 {
+            return nil, ErrRequestPolicy
+        }
+    }
+    if g.next == nil { return nil, ErrRequestPolicy }
+    response, failure := g.next.RoundTrip(req)
+    if failure != nil { return nil, ErrRequestFailed }
+    return response, nil
+}

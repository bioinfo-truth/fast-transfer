+package pcsconfig
+
+import "errors"
+
+// RequireVerifiedIdentityBinding intentionally rejects all login/persistence.
+// Do not replace it with force-login, fixed UID or optional profile data.
+func RequireVerifiedIdentityBinding() error {
+	return errors.New("verified_identity_binding_unavailable")
+}

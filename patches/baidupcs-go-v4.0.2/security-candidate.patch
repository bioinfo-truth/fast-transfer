+package requester
+
+import (
+	"crypto/tls"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type fixtureRoundTripper struct {
+	calls    int
+	redirect bool
+}
+
+func (f *fixtureRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	f.calls++
+	header := make(http.Header)
+	code := 200
+	if f.redirect {
+		code = 302
+		header.Set("Location", "https://other.baidu.com/offline-fixture")
+	}
+	return &http.Response{StatusCode: code, Header: header,
+		Body: io.NopCloser(strings.NewReader("fixture")), Request: req}, nil
+}
+func TestRejectBeforeTransport(t *testing.T) {
+	for _, address := range []string{"http://pan.baidu.com/fixture", "https://pan.baidu.com/fixture?BDUSS=FAKE_ONLY",
+		"https://FAKE_ONLY@pan.baidu.com/fixture", "https://pan.baidu.com.evil.invalid/fixture"} {
+		next := &fixtureRoundTripper{}
+		request, _ := http.NewRequest("POST", address, strings.NewReader("BDUSS=FAKE_ONLY"))
+		if _, err := (guardedTransport{next: next}).RoundTrip(request); err != ErrRequestPolicy {
+			t.Fatal("policy not enforced")
+		}
+		if next.calls != 0 {
+			t.Fatal("request reached transport")
+		}
+	}
+}
+func TestRedirectIsNotFollowed(t *testing.T) {
+	next := &fixtureRoundTripper{redirect: true}
+	client := &http.Client{Transport: guardedTransport{next: next}, CheckRedirect: denyRedirect}
+	request, _ := http.NewRequest("POST", "https://pan.baidu.com/fixture", strings.NewReader("BDUSS=FAKE_ONLY"))
+	request.Header.Set("Cookie", "BDUSS=FAKE_ONLY")
+	response, err := client.Do(request)
+	if response != nil {
+		response.Body.Close()
+	}
+	if err == nil || next.calls != 1 {
+		t.Fatal("redirect followed or silently accepted")
+	}
+}
+func TestRejectInsecureConcreteTransport(t *testing.T) {
+	next := &http.Transport{TLSClientConfig: &tls.Config{InsecureSkipVerify: true}}
+	request, _ := http.NewRequest("GET", "https://pan.baidu.com/fixture", nil)
+	if _, err := (guardedTransport{next: next}).RoundTrip(request); err != ErrRequestPolicy {
+		t.Fatal("insecure transport accepted")
+	}
+}
+
+func TestConstructionErrorsAreRedacted(t *testing.T) {
+	for _, test := range [][2]string{{"GET", "https://pan.baidu.com/%zzFAKE_ONLY"},
+		{"BAD\nFAKE_ONLY", "https://pan.baidu.com/fixture"}, {"GET", "https://pan.baidu.com/FAKE_ONLY\n"}} {
+		request, err := newPolicyRequest(test[0], test[1], nil)
+		if request != nil || err != ErrRequestPolicy || strings.Contains(err.Error(), "FAKE_ONLY") {
+			t.Fatal("construction error not redacted")
+		}
+	}
+}
+
+type errorBody struct{}
+
+func (errorBody) Read(p []byte) (int, error) {
+	copy(p, "FAKE_ONLY")
+	return 1, errors.New("FAKE_ONLY body error")
+}
+func TestReadFailureDropsPartialDataAndError(t *testing.T) {
+	data, err := redactedReadAll(errorBody{})
+	if data != nil || err != ErrRequestFailed {
+		t.Fatal("read failure leaked")
+	}
+}
+
+type errorTransport struct{}
+
+func (errorTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, errors.New("FAKE_ONLY transport error")
+}
+func TestTransportErrorRedacted(t *testing.T) {
+	request, _ := http.NewRequest("GET", "https://pan.baidu.com/fixture", nil)
+	response, err := (guardedTransport{next: errorTransport{}}).RoundTrip(request)
+	if response != nil || err != ErrRequestFailed {
+		t.Fatal("transport error leaked")
+	}
+}
